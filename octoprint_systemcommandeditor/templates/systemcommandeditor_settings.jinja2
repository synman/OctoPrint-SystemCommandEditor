{% macro icon_field(input_id, fallback) %}
<div class="control-group">
    <label class="control-label" for="{{ input_id }}">{{ _('Icon') }}</label>
    <div class="controls">
        <div class="sce-icon-field">
            <div class="input-prepend sce-icon-input">
                <span class="add-on"><i data-bind="css: (icon() || '{{ fallback }}') + (iconInvert() ? ' sce-icon-inverted' : ''), style: iconInvert() ? { backgroundColor: iconColor() } : { color: iconColor() }"></i></span>
                <input type="text" id="{{ input_id }}" autocomplete="off" placeholder="{{ fallback }}" data-bind="textInput: icon, hasFocus: iconSuggest.focused, event: { keydown: iconSuggest.keydown, keyup: iconSuggest.keyup }">
            </div>
            <div class="sce-icon-suggest" data-bind="visible: iconSuggest.visible">
                <div data-bind="with: iconSuggest">
                    <div data-bind="foreach: items">
                        <div class="sce-icon-suggest-item" data-bind="css: { active: $index() === $parent.index() }, event: { mousedown: $parent.pick }">
                            <i data-bind="css: $data.cls"></i>
                            <span class="sce-icon-suggest-cls" data-bind="text: $data.cls"></span>
                            <span class="muted" data-bind="text: $data.label"></span>
                        </div>
                    </div>
                    <div class="muted sce-icon-suggest-more" data-bind="visible: more() > 0, text: 'and ' + more() + ' more, keep typing'"></div>
                </div>
            </div>
        </div>
        <div class="btn-group sce-icon-style">
            <label class="btn btn-small sce-icon-color" title="{{ _('Icon color')|edq }}" data-bind="css: { active: iconColor() }">
                <i class="fa-solid fa-eye-dropper" data-bind="style: { color: iconColor() }"></i>
                <input type="color" data-bind="value: iconColorPick">
            </label>
            <button type="button" class="btn btn-small sce-icon-invert" title="{{ _('Invert: a light icon on a badge of its color')|edq }}" data-bind="click: function() { iconInvert(!iconInvert()) }, css: { active: iconInvert() }"><i class="fa-solid fa-circle-half-stroke"></i></button>
            <button type="button" class="btn btn-small sce-icon-color-clear" title="{{ _('No icon color')|edq }}" data-bind="click: function() { iconColor('') }, css: { active: !iconColor() }"><i class="fa-solid fa-droplet-slash"></i></button>
        </div>
        <div class="sce-icon-picks" data-bind="foreach: $root.iconChoices">
            <button type="button" class="btn btn-mini" data-bind="click: function() { $parent.icon($data) }, attr: { title: $data }, css: { active: $parent.icon() === $data }"><i data-bind="css: $data"></i></button>
        </div>
        <span class="help-block">{{ _('Any Font Awesome 6 icon class.') }}</span>
    </div>
</div>
{% endmacro %}

{% macro device_block() %}
<!-- ko ifnot: isSection() -->
<div class="control-group" data-bind="css: { error: deviceError() || roleError() || valueError() }">
    <label class="control-label" for="sce-editor-device">{{ _('Control') }}</label>
    <div class="controls">
        <select id="sce-editor-device" class="input-block-level" data-bind="options: deviceChoices, optionsValue: 'id', optionsText: 'name', value: device"></select>
        <!-- ko if: device() -->
        <select class="input-block-level sce-role" data-bind="options: roleChoices, optionsValue: 'value', optionsText: 'label', value: role" aria-label="{{ _('Role')|edq }}"></select>
        <!-- ko if: role() === 'choice' -->
        <input type="text" class="input-block-level" data-bind="textInput: value" placeholder="{{ _('e.g. 1080')|edq }}">
        <!-- /ko -->
        <!-- /ko -->
        <span class="help-block" data-bind="text: deviceError, visible: deviceError"></span>
        <span class="help-block" data-bind="text: roleError, visible: roleError"></span>
        <span class="help-block" data-bind="text: valueError, visible: valueError"></span>
        <span class="help-block" data-bind="visible: !deviceError() && !roleError() && !valueError()">{{ _('Put this command on a control, so the System menu shows it as that control\'s on, off or choice command.') }}</span>
    </div>
</div>

{{ condition_block() }}
{{ control_condition_block() }}
<!-- /ko -->
{% endmacro %}

{% macro control_condition_block() %}
<!-- ko if: control.visible() && !isCore() -->
<div class="control-group" data-bind="css: { error: control.error() }">
    <div class="controls">
        <label class="checkbox"><input type="checkbox" data-bind="checked: control.enabled"> <span data-bind="text: control.enableLabel"></span></label>
        <!-- ko if: control.enabled -->
        <div class="sce-condition">
            <p class="sce-condition-sentence">
                <span data-bind="text: control.availableLabel"></span>
                <select class="input-medium" data-bind="value: control.mode" aria-label="{{ _('Mode')|edq }}">
                    <option value="only">{{ _('Only when') }}</option>
                    <option value="never">{{ _('Never when') }}</option>
                </select>
                <!-- ko if: control.loading -->
                <span class="muted">{{ _('Loading states…') }}</span>
                <!-- /ko -->
                <!-- ko if: control.hasChoices -->
                <span class="sce-state-picks" data-bind="foreach: control.choices">
                    <label class="checkbox inline"><input type="checkbox" data-bind="checkedValue: $data, checked: $parent.control.picked"> <span data-bind="text: $data"></span></label>
                </span>
                <!-- /ko -->
                <!-- ko ifnot: control.hasChoices -->
                <input type="text" class="input-block-level" data-bind="textInput: control.typed" placeholder="{{ _('e.g. Idle, Run')|edq }}" aria-label="{{ _('States')|edq }}">
                <!-- /ko -->
                <select class="input-medium" data-bind="value: control.effect" aria-label="{{ _('Effect')|edq }}">
                    <option value="disable">{{ _('Gray out') }}</option>
                    <option value="hide">{{ _('Hide') }}</option>
                </select>.
            </p>
            <span class="help-block" data-bind="text: control.error, visible: control.error"></span>
        </div>
        <!-- /ko -->
    </div>
</div>
<!-- /ko -->
{% endmacro %}

{% macro condition_block() %}
<div class="control-group" data-bind="css: { error: condition.error() }">
    <div class="controls">
        <label class="checkbox"><input type="checkbox" data-bind="checked: condition.enabled"> {{ _('Limit to printer states') }}</label>
        <!-- ko if: condition.enabled -->
        <div class="sce-condition">
            <p class="sce-condition-sentence">
                {{ _('Available') }}
                <select class="input-medium" data-bind="value: condition.mode" aria-label="{{ _('Mode')|edq }}">
                    <option value="only">{{ _('only while') }}</option>
                    <option value="never">{{ _('except while') }}</option>
                </select>
                {{ _('the printer is') }}
                <span class="sce-state-picks">
                    <label class="checkbox inline"><input type="checkbox" value="printing" data-bind="checked: condition.states"> {{ _('Printing') }}</label>
                    <label class="checkbox inline"><input type="checkbox" value="paused" data-bind="checked: condition.states"> {{ _('Paused') }}</label>
                    <label class="checkbox inline"><input type="checkbox" value="ready" data-bind="checked: condition.states"> {{ _('Ready') }}</label>
                    <label class="checkbox inline"><input type="checkbox" value="offline" data-bind="checked: condition.states"> {{ _('Offline') }}</label>
                    <label class="checkbox inline"><input type="checkbox" value="error" data-bind="checked: condition.states"> {{ _('Error') }}</label>
                </span>.
                {{ _('When it isn\'t available,') }}
                <select class="input-medium" data-bind="value: condition.effect" aria-label="{{ _('Effect')|edq }}">
                    <option value="disable">{{ _('gray it out') }}</option>
                    <option value="hide">{{ _('hide it') }}</option>
                </select>.
            </p>
            <span class="help-block" data-bind="text: condition.error, visible: condition.error"></span>
            <p class="help-block sce-condition-summary" data-bind="text: condition.summary"></p>
        </div>
        <!-- /ko -->
    </div>
</div>
{% endmacro %}

<h3>{{ _('System Commands') }}</h3>

<p class="muted">
    {{ _('Controls show a state and gather the commands that drive it: switches, selectors, actions, readouts and links. Built-in commands are OctoPrint\'s own. Custom commands are yours, with section headings and placed readouts, in menu order. Changes take effect when you click Save.') }}
</p>

<div class="sce-options">
    <div class="sce-option">
    <label class="checkbox">
        <input type="checkbox" data-bind="checked: settingsViewModel.settings.plugins.systemcommandeditor.success_toast">
        {{ _('Show a success message when a command finishes') }}
    </label>
    <span class="help-block">{{ _('Off by default: the menu already shows a spinning busy icon while a command runs and a check or a cross when it ends. Background commands and failures always show a message.') }}</span>
    </div>
    <div class="sce-option sce-busy-icon">
        <span>{{ _('Busy icon') }}</span>
        <span class="sce-busy-preview"><i data-bind="css: $root.busyIcon() + ' fa-spin fa-fw'"></i></span>
        <div class="sce-icon-picks" data-bind="foreach: $root.busyIcons">
            <button type="button" class="btn btn-mini" data-bind="click: function() { $root.pickBusyIcon($data) }, attr: { title: $data.replace('fa-solid fa-', '') }, css: { active: $root.busyIcon() === $data }"><i data-bind="css: $data + ' fa-fw'"></i></button>
        </div>
        <span class="help-block">{{ _('The icon a command shows while it runs. Only icons that read well turning are offered.') }}</span>
    </div>
    <div class="sce-option">
    <label class="checkbox">
        <input type="checkbox" data-bind="checked: settingsViewModel.settings.plugins.systemcommandeditor.live_updates">
        {{ _('Update control states and readouts while the System menu is open, every') }}
        <input type="number" min="1" class="input-mini" data-bind="value: settingsViewModel.settings.plugins.systemcommandeditor.live_interval, enable: settingsViewModel.settings.plugins.systemcommandeditor.live_updates">
        {{ _('seconds') }}
    </label>
    <span class="help-block">{{ _('Off by default. Each update runs every status command on the OctoPrint server.') }}</span>
    </div>
</div>

<h4 class="sce-group-title">{{ _('Controls') }}</h4>
<p class="muted">
    {{ _('A switch has On and Off commands, a selector has a command for each choice, an action has one or more Run commands, a readout shows a status, and a link opens a page.') }}
</p>

<div class="sce-list" data-bind="css: { 'sce-list-empty': devices().length === 0 }">
    <div class="sce-empty muted" data-bind="visible: devices().length === 0">
        {{ _('You have no controls yet. Add one with the button below.') }}
    </div>
    <!-- ko foreach: devices -->
    <div class="sce-row sce-device-row">
        <span class="sce-icon"><i data-bind="css: ($data.icon || '') + ($data.icon_invert ? ' sce-icon-inverted' : ''), style: $data.icon_invert ? { backgroundColor: $data.icon_color || '' } : { color: $data.icon_color || '' }"></i></span>
        <span class="sce-text">
            <span class="sce-name" data-bind="text: $data.name"></span>
            <span class="muted" data-bind="text: $root.typeLabel($data.type)"></span>
        </span>
        <span class="btn-group sce-buttons">
            <!-- ko if: $data.type === 'readout' && !$root.isPlaced($data) -->
            <button type="button" class="btn btn-mini" title="{{ _('Show this readout in the System menu')|edq }}" data-bind="click: $root.placeInMenu"><i class="fa-solid fa-bars-staggered"></i> {{ _('Place in menu') }}</button>
            <!-- /ko -->
            <button type="button" class="btn btn-mini btn-primary" title="{{ _('Edit')|edq }}" data-bind="click: $root.editDevice"><i class="fa-solid fa-pencil"></i></button>
            <button type="button" class="btn btn-mini btn-danger" title="{{ _('Delete')|edq }}" data-bind="click: $root.removeDevice"><i class="fa-solid fa-trash"></i></button>
        </span>
    </div>
    <!-- /ko -->
</div>

<div class="sce-add-buttons">
    <button type="button" class="btn" data-bind="click: addDevice"><i class="fa-solid fa-plug"></i> {{ _('Add control') }}</button>
    <button type="button" class="btn" data-bind="click: presets.open"><i class="fa-solid fa-wand-magic-sparkles"></i> {{ _('Add from presets') }}</button>
</div>

<!-- ko if: coreEntries().length -->
<h4 class="sce-group-title">{{ _('Built-in commands') }}</h4>
<p class="muted">
    {{ _('OctoPrint\'s own shutdown, reboot and restart commands. Change their icon or heading, or put them on a control. What they run is set under') }}
    <a href="javascript:void(0)" data-bind="click: showServerSettings">{{ _('Server') }}</a>.
</p>
<div class="sce-list sce-core-list">
    <!-- ko foreach: coreRows -->
    <!-- ko if: $data.heading -->
    <div class="sce-row sce-section"><span class="sce-section-label" data-bind="text: $data.heading"></span></div>
    <!-- /ko -->
    <!-- ko if: $data.kind === 'control' -->
    <div class="sce-row sce-control">
        <span class="sce-icon"><i data-bind="css: ($data.device.icon || '') + ($data.device.icon_invert ? ' sce-icon-inverted' : ''), style: $data.device.icon_invert ? { backgroundColor: $data.device.icon_color || '' } : { color: $data.device.icon_color || '' }"></i></span>
        <span class="sce-text">
            <span class="sce-name" data-bind="text: $data.device.name"></span>
            <span class="muted" data-bind="text: $root.typeLabel($data.device.type)"></span>
        </span>
        <span class="sce-buttons sce-member-buttons">
            <!-- ko foreach: $data.buttons -->
            <button type="button" class="btn btn-mini sce-btn" data-bind="attr: { title: $data.name, 'data-core-action': $data.action }, click: $root.editCoreAction"><i data-bind="css: $data.icon"></i></button>
            <!-- /ko -->
        </span>
    </div>
    <!-- /ko -->
    <!-- ko if: $data.kind === 'command' -->
    <div class="sce-row sce-command">
        <span class="sce-icon"><i data-bind="css: ($data.icon || '') + ($data.icon_invert ? ' sce-icon-inverted' : ''), style: $data.icon_invert ? { backgroundColor: $data.icon_color || '' } : { color: $data.icon_color || '' }"></i></span>
        <span class="sce-text"><span class="sce-name" data-bind="text: $data.name"></span></span>
        <span class="sce-badges">
            <span class="label label-info sce-member" data-bind="visible: $root.badgeFor($data), text: $root.badgeFor($data)"></span>
        </span>
        <span class="btn-group sce-buttons">
            <button type="button" class="btn btn-mini btn-primary" title="{{ _('Edit icon, heading, control and condition')|edq }}" data-bind="attr: { 'data-core-action': $data.action }, click: $root.editCoreAction"><i class="fa-solid fa-pencil"></i></button>
        </span>
    </div>
    <!-- /ko -->
    <!-- /ko -->
</div>
<!-- /ko -->

<h4 class="sce-group-title">{{ _('Custom commands') }}</h4>
<p class="muted">
    {{ _('Your own commands, section headings and placed readouts, in the order the System menu shows them.') }}
</p>
<div class="sce-list" data-bind="css: { 'sce-list-empty': entries().length === 0 }">
    <div class="sce-empty muted" data-bind="visible: entries().length === 0">
        {{ _('You have no custom commands yet. Add one with the buttons below.') }}
    </div>

    <!-- ko foreach: customRows -->
    <div class="sce-row" draggable="true"
         data-bind="css: { 'sce-section': $root.isSection($data), 'sce-command': !$root.isSection($data) && !$root.isControl($data), 'sce-control': $root.isControl($data), 'sce-drag-over': $root.dragOver() === $data },
                    event: { dragstart: $root.dragStart, dragenter: $root.dragEnterRow, dragover: $root.dragOverRow, dragleave: $root.dragLeave, drop: $root.dropRow, dragend: $root.dragEnd }">
        <span class="sce-handle" title="{{ _('Drag to move')|edq }}"><i class="fa-solid fa-grip-vertical"></i></span>

        <!-- ko if: $root.isSection($data) -->
        <span class="sce-section-label">
            <!-- ko if: $data.name --><span data-bind="text: $data.name"></span><!-- /ko -->
            <!-- ko ifnot: $data.name --><span class="muted">{{ _('Divider') }}</span><!-- /ko -->
        </span>
        <!-- /ko -->

        <!-- ko if: $root.isPlacement($data) -->
        <span class="sce-icon"><i data-bind="css: (($root.deviceOf($data) || {}).icon || '') + (($root.deviceOf($data) || {}).icon_invert ? ' sce-icon-inverted' : ''), style: ($root.deviceOf($data) || {}).icon_invert ? { backgroundColor: ($root.deviceOf($data) || {}).icon_color || '' } : { color: ($root.deviceOf($data) || {}).icon_color || '' }"></i></span>
        <span class="sce-text">
            <span class="sce-name" data-bind="text: $data.name"></span>
            <span class="muted">{{ _('Readout') }}</span>
        </span>
        <!-- /ko -->

        <!-- ko if: $root.isControl($data) -->
        <span class="sce-icon"><i data-bind="css: (($root.controlOf($data) || {}).icon || '') + (($root.controlOf($data) || {}).icon_invert ? ' sce-icon-inverted' : ''), style: ($root.controlOf($data) || {}).icon_invert ? { backgroundColor: ($root.controlOf($data) || {}).icon_color || '' } : { color: ($root.controlOf($data) || {}).icon_color || '' }"></i></span>
        <span class="sce-text">
            <span class="sce-name" data-bind="text: $root.controlOf($data).name"></span>
            <span class="muted" data-bind="text: $root.typeLabel($root.controlOf($data).type)"></span>
        </span>
        <span class="sce-buttons sce-member-buttons">
            <!-- ko foreach: $root.buttonsOf($data) -->
            <button type="button" class="btn btn-mini sce-btn" data-bind="attr: { title: $data.name, 'data-action': $data.action }, click: $root.editMemberAction"><i data-bind="css: $data.icon"></i></button>
            <!-- /ko -->
        </span>
        <!-- /ko -->

        <!-- ko if: $root.isCommand($data) -->
        <span class="sce-icon"><i data-bind="css: ($data.icon || '') + ($data.icon_invert ? ' sce-icon-inverted' : ''), style: $data.icon_invert ? { backgroundColor: $data.icon_color || '' } : { color: $data.icon_color || '' }"></i></span>
        <span class="sce-text">
            <span class="sce-name" data-bind="text: $data.name"></span>
            <code class="sce-cmd" data-bind="text: $data.command, attr: { title: $data.command }"></code>
        </span>
        <span class="sce-badges">
            <span class="label label-info sce-member" data-bind="visible: $root.badgeFor($data), text: $root.badgeFor($data)"></span>
            <span class="label" data-bind="visible: $data.confirm" title="{{ _('Asks for confirmation')|edq }}"><i class="fa-solid fa-circle-question"></i></span>
            <span class="label" data-bind="visible: $data.async" title="{{ _('Runs in the background')|edq }}"><i class="fa-solid fa-hourglass-half"></i></span>
            <span class="label" data-bind="visible: $data.fresh_credentials" title="{{ _('Requires a recent login')|edq }}"><i class="fa-solid fa-key"></i></span>
            <span class="label" data-bind="visible: $data.ignore" title="{{ _('Ignores errors')|edq }}"><i class="fa-solid fa-eye-slash"></i></span>
        </span>
        <!-- /ko -->

        <span class="btn-group sce-buttons">
            <button type="button" class="btn btn-mini" title="{{ _('Move up')|edq }}" data-bind="click: $root.moveUp, enable: $root.canMove($data, -1)"><i class="fa-solid fa-arrow-up"></i></button>
            <button type="button" class="btn btn-mini" title="{{ _('Move down')|edq }}" data-bind="click: $root.moveDown, enable: $root.canMove($data, 1)"><i class="fa-solid fa-arrow-down"></i></button>
            <!-- ko if: $root.isPlacement($data) -->
            <button type="button" class="btn btn-mini btn-primary" title="{{ _('Edit this readout in Controls')|edq }}" data-bind="click: $root.editPlacement"><i class="fa-solid fa-pencil"></i></button>
            <button type="button" class="btn btn-mini btn-danger" title="{{ _('Remove from the System menu; the control stays in Controls')|edq }}" data-bind="click: $root.removePlacement"><i class="fa-solid fa-trash"></i></button>
            <!-- /ko -->
            <!-- ko ifnot: $root.isPlacement($data) -->
            <!-- ko ifnot: $root.isControl($data) -->
            <button type="button" class="btn btn-mini btn-primary" title="{{ _('Edit')|edq }}" data-bind="click: $root.edit"><i class="fa-solid fa-pencil"></i></button>
            <!-- ko if: $root.isCommand($data) -->
            <button type="button" class="btn btn-mini" title="{{ _('Duplicate')|edq }}" data-bind="click: $root.duplicate"><i class="fa-solid fa-copy"></i></button>
            <!-- /ko -->
            <!-- /ko -->
            <button type="button" class="btn btn-mini btn-danger" title="{{ _('Delete')|edq }}" data-bind="click: $root.remove"><i class="fa-solid fa-trash"></i></button>
            <!-- /ko -->
        </span>
    </div>
    <!-- /ko -->
</div>

<div class="sce-add-buttons">
    <button type="button" class="btn" data-bind="click: addCommand"><i class="fa-regular fa-square-plus"></i> {{ _('Add command') }}</button>
    <button type="button" class="btn" data-bind="click: addSection"><i class="fa-solid fa-grip-lines"></i> {{ _('Add section') }}</button>
</div>

<!-- Editor -->
<div id="sce-editor" class="modal hide" data-bind="with: editor">
    <div class="modal-header">
        <a href="javascript:void(0)" class="close" data-bind="click: cancel">&times;</a>
        <h3 data-bind="text: title"></h3>
    </div>
    <div class="modal-body">
        <form class="form-horizontal" data-bind="submit: done">
            <!-- ko if: isSection() -->
            <div class="control-group">
                <label class="control-label" for="sce-editor-section-name">{{ _('Section name') }}</label>
                <div class="controls">
                    <input type="text" id="sce-editor-section-name" class="input-block-level" data-bind="textInput: name" placeholder="{{ _('Optional, e.g. Printer')|edq }}">
                    <span class="help-block">{{ _('Shown as a heading in the System menu. Leave empty for a plain divider line.') }}</span>
                </div>
            </div>
            <!-- /ko -->

            <!-- ko if: isCore() -->
            <div class="control-group">
                <label class="control-label">{{ _('Command') }}</label>
                <div class="controls"><span class="sce-core-name" data-bind="text: name"></span></div>
            </div>
            <div class="control-group">
                <label class="control-label" for="sce-editor-heading">{{ _('Heading above') }}</label>
                <div class="controls">
                    <input type="text" id="sce-editor-heading" class="input-block-level" data-bind="textInput: heading" placeholder="{{ _('Optional, e.g. System')|edq }}">
                    <span class="help-block">{{ _('Shown in the System menu above this command. Leave empty for none.') }}</span>
                </div>
            </div>
            <!-- /ko -->

            <!-- ko if: !isSection() && !isCore() -->
            <div class="control-group" data-bind="css: { error: nameError() }">
                <label class="control-label" for="sce-editor-name">{{ _('Name') }}</label>
                <div class="controls">
                    <input type="text" id="sce-editor-name" class="input-block-level" data-bind="textInput: name" placeholder="{{ _('e.g. Restart webcam')|edq }}">
                    <span class="help-block" data-bind="text: nameError, visible: nameError"></span>
                </div>
            </div>

            <!-- ko if: isGcode -->
            <div class="control-group" data-bind="css: { error: commandError() }">
                <label class="control-label" for="sce-editor-gcode">{{ _('G-code') }}</label>
                <div class="controls">
                    <textarea id="sce-editor-gcode" class="input-block-level sce-mono" rows="4" data-bind="textInput: gcodeText" placeholder="{{ _('e.g. G28')|edq }}"></textarea>
                    <span class="help-block" data-bind="visible: !commandError()">{{ _('One G-code line per line, sent to the printer in order.') }}</span>
                    <span class="help-block" data-bind="text: commandError, visible: commandError"></span>
                </div>
            </div>
            <!-- /ko -->
            <!-- ko if: isRunOnly -->
            <div class="control-group">
                <label class="control-label">{{ _('Runs') }}</label>
                <div class="controls">
                    <code class="sce-run-line" data-bind="text: runText"></code>
                    <span class="help-block">{{ _('A command another plugin provides. It runs through that plugin, not in a shell.') }}</span>
                </div>
            </div>
            <!-- /ko -->
            <!-- ko ifnot: runCall -->
            <div class="control-group" data-bind="css: { error: commandError() }">
                <label class="control-label" for="sce-editor-command">{{ _('Command') }}</label>
                <div class="controls">
                    <textarea id="sce-editor-command" class="input-block-level sce-mono" rows="3" data-bind="textInput: command" placeholder="{{ _('e.g. sudo systemctl restart webcamd')|edq }}"></textarea>
                    <span class="help-block" data-bind="visible: !commandError()">{{ _('Runs in a shell as the user OctoPrint runs as.') }}</span>
                    <span class="help-block" data-bind="text: commandError, visible: commandError"></span>
                </div>
            </div>
            <!-- /ko -->

            <!-- /ko -->

            {{ device_block() }}

            <!-- ko ifnot: isSection() -->
            {{ icon_field('sce-editor-icon', 'fa-solid fa-terminal') }}

            <!-- /ko -->

            <!-- ko if: !isSection() && !isCore() -->
            <div class="control-group">
                <div class="controls">
                    <label class="checkbox"><input type="checkbox" data-bind="checked: useConfirm"> {{ _('Ask for confirmation before running') }}</label>
                    <!-- ko if: useConfirm -->
                    <input type="text" class="input-block-level sce-confirm-message" data-bind="textInput: confirmMessage" placeholder="{{ _('e.g. You are about to restart the webcam.')|edq }}">
                    <div class="sce-preview">
                        <span class="muted">{{ _('The confirmation will show your message and this command:') }}</span>
                        <pre class="sce-preview-command" data-bind="text: command"></pre>
                    </div>
                    <!-- /ko -->
                    <label class="checkbox"><input type="checkbox" data-bind="checked: async"> {{ _('Run in the background') }}</label>
                    <span class="help-block sce-indent">{{ _('The menu does not wait for the command to finish. Use this for commands that stop or restart OctoPrint.') }}</span>
                    <label class="checkbox"><input type="checkbox" data-bind="checked: freshCredentials"> {{ _('Require a recent login') }}</label>
                    <label class="checkbox"><input type="checkbox" data-bind="checked: ignore"> {{ _('Ignore errors') }}</label>
                </div>
            </div>
            <!-- /ko -->
            <button type="submit" class="hide"></button>
        </form>
    </div>
    <div class="modal-footer">
        <!-- ko if: canDuplicate -->
        <button type="button" class="btn pull-left" data-bind="click: duplicate"><i class="fa-solid fa-copy"></i> {{ _('Duplicate') }}</button>
        <!-- /ko -->
        <!-- ko if: !isSection() && !isCore() -->
        <button type="button" class="btn pull-left" data-bind="click: runNow, enable: canRun, attr: { title: runTitle }"><i class="fa-solid fa-play"></i> {{ _('Run now') }}</button>
        <!-- /ko -->
        <button type="button" class="btn" data-bind="click: cancel">{{ _('Cancel') }}</button>
        <button type="button" class="btn btn-primary" data-bind="click: done, enable: valid">{{ _('Done') }}</button>
    </div>
</div>

<!-- Presets picker -->
<div id="sce-presets" class="modal hide" data-bind="with: presets">
    <div class="modal-header">
        <a href="javascript:void(0)" class="close" data-bind="click: cancel">&times;</a>
        <h3>{{ _('Presets') }}</h3>
    </div>
    <div class="modal-body">
        <div data-bind="visible: loading" class="muted">
            <i class="fa-solid fa-spinner fa-spin"></i> {{ _('Checking this system…') }}
        </div>
        <div data-bind="visible: failed" class="muted">{{ _('Could not check this system.') }}</div>
        <h4 data-bind="visible: !loading() && !failed()">{{ _('Switches') }}</h4>
        <div class="sce-list" data-group="switches" data-bind="visible: !loading() && !failed()">
            <!-- ko foreach: switches -->
            <div class="sce-row sce-preset-row">
                <label>
                    <input type="checkbox" data-bind="checked: checked">
                </label>
                <span class="sce-icon"><i data-bind="css: $data.item.icon || ''"></i></span>
                <span class="sce-text">
                    <span class="sce-name" data-bind="text: $data.item.name"></span>
                    <span class="muted">{{ _('Switch for OctoPrint\'s own commands') }}</span>
                </span>
            </div>
            <!-- /ko -->
        </div>
        <h4 data-bind="visible: !loading() && !failed()">{{ _('Readouts') }}</h4>
        <div class="sce-list" data-group="readouts" data-bind="visible: !loading() && !failed()">
            <!-- ko foreach: readouts -->
            <div class="sce-row sce-preset-row">
                <label>
                    <input type="checkbox" data-bind="checked: checked">
                </label>
                <span class="sce-icon"><i data-bind="css: $data.item.icon || ''"></i></span>
                <span class="sce-text">
                    <span class="sce-name" data-bind="text: $data.item.name"></span>
                    <span class="muted" data-bind="text: $data.item.value || '', visible: $data.item.value"></span>
                </span>
                <span class="muted" data-bind="text: $parent.label($data), visible: $parent.label($data)"></span>
            </div>
            <!-- /ko -->
        </div>
        <h4 data-bind="visible: !loading() && !failed()">{{ _('Maintenance commands') }}</h4>
        <div class="sce-list" data-group="maintenance" data-bind="visible: !loading() && !failed()">
            <!-- ko foreach: maintenance -->
            <div class="sce-row sce-preset-row">
                <label>
                    <input type="checkbox" data-bind="checked: checked">
                </label>
                <span class="sce-icon"><i data-bind="css: $data.item.icon || ''"></i></span>
                <span class="sce-text">
                    <span class="sce-name" data-bind="text: $data.item.name"></span>
                    <span class="muted" data-bind="text: $data.note, visible: $data.note && $data.item.available"></span>
                </span>
                <span class="muted" data-bind="text: $parent.label($data), visible: $parent.label($data)"></span>
            </div>
            <!-- /ko -->
        </div>
        <!-- ko if: plugins().length -->
        <h4 data-bind="visible: !loading() && !failed()">{{ _('Plugin devices') }}</h4>
        <!-- ko foreach: plugins -->
        <h5 class="sce-plugin-group" data-bind="text: $data.name, visible: !$parent.loading() && !$parent.failed()"></h5>
        <div class="sce-list" data-group="plugins" data-bind="visible: !$parent.loading() && !$parent.failed()">
            <!-- ko foreach: rows -->
            <div class="sce-row sce-preset-row sce-plugin-row">
                <label>
                    <input type="checkbox" data-bind="checked: checked">
                </label>
                <span class="sce-icon"><i data-bind="css: $data.item.control.icon || ''"></i></span>
                <span class="sce-text">
                    <span class="sce-name" data-bind="text: $data.item.name"></span>
                    <span class="muted" data-bind="text: $data.type"></span>
                </span>
                <span class="muted" data-bind="text: $data.label, visible: $data.label"></span>
            </div>
            <!-- /ko -->
        </div>
        <!-- /ko -->
        <!-- /ko -->
    </div>
    <div class="modal-footer">
        <button type="button" class="btn" data-bind="click: cancel">{{ _('Cancel') }}</button>
        <button type="button" class="btn btn-primary" data-bind="click: apply, enable: canApply">{{ _('Apply') }}</button>
    </div>
</div>

<!-- Device editor -->
<div id="sce-device-editor" class="modal hide" data-bind="with: deviceEditor">
    <div class="modal-header">
        <a href="javascript:void(0)" class="close" data-bind="click: cancel">&times;</a>
        <h3 data-bind="text: title"></h3>
    </div>
    <div class="modal-body">
        <form class="form-horizontal" data-bind="submit: done">
            <div class="control-group">
                <label class="control-label" for="sce-device-type">{{ _('Type') }}</label>
                <div class="controls">
                    <select id="sce-device-type" class="input-block-level" data-bind="options: typeChoices, optionsValue: 'value', optionsText: 'label', value: type"></select>
                </div>
            </div>

            <div class="control-group" data-bind="css: { error: nameError() }">
                <label class="control-label" for="sce-device-name">{{ _('Name') }}</label>
                <div class="controls">
                    <input type="text" id="sce-device-name" class="input-block-level" data-bind="textInput: name" placeholder="{{ _('e.g. Laser')|edq }}">
                    <span class="help-block" data-bind="text: nameError, visible: nameError"></span>
                </div>
            </div>

            {{ icon_field('sce-device-icon', 'fa-solid fa-plug') }}

            <!-- ko if: hasStatus() && !hasRead() -->
            <div class="control-group" data-bind="css: { error: statusError() }">
                <label class="control-label" for="sce-device-status">{{ _('Status command') }}</label>
                <div class="controls">
                    <textarea id="sce-device-status" class="input-block-level sce-mono" rows="2" data-bind="textInput: status"></textarea>
                    <span class="help-block">{{ _('Runs on the OctoPrint server when the System menu opens.') }}</span>
                    <span class="help-block" data-bind="text: statusError, visible: statusError"></span>
                </div>
            </div>
            <!-- /ko -->

            <!-- ko if: hasRead -->
            <div class="control-group">
                <label class="control-label">{{ _('Reads') }}</label>
                <div class="controls">
                    <code class="sce-read-line" data-bind="text: readText"></code>
                    <span class="help-block">{{ _('Read when the System menu opens. Reads come from another plugin or an MQTT topic.') }}</span>
                </div>
            </div>
            <!-- /ko -->

            <!-- ko if: isSwitch -->
            <div class="control-group">
                <label class="control-label" for="sce-device-on">{{ _('On pattern') }}</label>
                <div class="controls">
                    <input type="text" id="sce-device-on" class="input-block-level sce-mono" data-bind="textInput: onPattern">
                </div>
            </div>
            <div class="control-group">
                <label class="control-label" for="sce-device-off">{{ _('Off pattern') }}</label>
                <div class="controls">
                    <input type="text" id="sce-device-off" class="input-block-level sce-mono" data-bind="textInput: offPattern">
                    <span class="help-block">{{ _('Leave both empty to use the exit code: 0 means on.') }}</span>
                </div>
            </div>
            <!-- /ko -->

            <!-- ko if: isLink -->
            <div class="control-group" data-bind="css: { error: urlError() }">
                <label class="control-label" for="sce-device-url">{{ _('URL') }}</label>
                <div class="controls">
                    <input type="text" id="sce-device-url" class="input-block-level" data-bind="textInput: url">
                    <span class="help-block" data-bind="text: urlError, visible: urlError"></span>
                </div>
            </div>
            <!-- /ko -->

            <!-- ko if: hasSection -->
            <div class="control-group">
                <label class="control-label" for="sce-device-section">{{ _('Section') }}</label>
                <div class="controls">
                    <select id="sce-device-section" class="input-block-level" data-bind="options: sectionChoices, optionsValue: 'value', optionsText: 'label', value: section"></select>
                    <span class="help-block">{{ _('The divider in the System menu this control is shown under.') }}</span>
                </div>
            </div>
            <!-- /ko -->

            <!-- ko if: isLink -->
            {{ condition_block() }}
            <!-- /ko -->
            <button type="submit" class="hide"></button>
        </form>
    </div>
    <div class="modal-footer">
        <!-- ko if: canDuplicate -->
        <button type="button" class="btn pull-left" data-bind="click: duplicate"><i class="fa-solid fa-copy"></i> {{ _('Duplicate') }}</button>
        <!-- /ko -->
        <button type="button" class="btn" data-bind="click: cancel">{{ _('Cancel') }}</button>
        <button type="button" class="btn btn-primary" data-bind="click: done, enable: valid">{{ _('Done') }}</button>
    </div>
</div>
